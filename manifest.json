{
  "type": "plugin",
  "id": "org.edgeever.plugins.ai-rss",
  "name": "EdgeEver AI RSS",
  "version": "0.1.0",
  "apiVersion": "1",
  "description": "AI-first RSS and Atom reading, translation, summarization, filtering, recommendations, and note capture.",
  "author": "EdgeEver",
  "entry": "./main.js",
  "platforms": ["web", "desktop"],
  "permissions": [
    "ai:generate",
    "network",
    "network:public",
    "storage",
    "notes:write",
    "metadata:read",
    "ui:commands",
    "ui:notices",
    "ui:panels"
  ],
  "networkHosts": [
    "openai.com",
    "blog.google",
    "huggingface.co",
    "github.blog",
    "blog.cloudflare.com",
    "sspai.com",
    "blog.yitianshijie.net",
    "www.nasa.gov",
    "www.quantamagazine.org",
    "www.smashingmagazine.com",
    "alistapart.com",
    "www.ycombinator.com",
    "stripe.com",
    "krebsonsecurity.com",
    "projectzero.google"
  ]
}
