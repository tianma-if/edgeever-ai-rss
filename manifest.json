{
  "type": "plugin",
  "id": "org.edgeever.plugins.ai-rss",
  "name": "EdgeEver AI RSS",
  "version": "0.5.4",
  "apiVersion": "2",
  "settingsUi": "host",
  "description": "AI-generated daily digests from curated RSS and Atom feeds, saved directly to EdgeEver notes.",
  "author": "EdgeEver",
  "entry": "./main.js",
  "platforms": ["web", "desktop"],
  "settings": {
    "fields": [
      { "key": "topics.ai", "type": "boolean", "label": "主题 · AI 前沿", "description": "信源：OpenAI News（openai.com）、Google AI（blog.google）、Google DeepMind（deepmind.google）、Apple Machine Learning Research（machinelearning.apple.com）、MIT AI News（news.mit.edu）、Hugging Face（huggingface.co）、TLDR AI（tldr.tech）、Ben's Bites（bensbites.com）、Import AI（importai.substack.com）、NLP Newsletter（nlp.elvissaravia.com）、Interconnects（interconnects.ai）、One Useful Thing（oneusefulthing.org）、科学空间（kexue.fm）、ChinAI Newsletter（chinai.substack.com）、Simon Willison's Weblog（simonwillison.net）、Gary Marcus（garymarcus.substack.com）、Dwarkesh Patel（dwarkeshpatel.com）、Latent Space（latent.space）", "default": true },
      { "key": "topics.engineering", "type": "boolean", "label": "主题 · 开发与开源", "description": "信源：GitHub Changelog（github.blog）、Cloudflare Blog（blog.cloudflare.com）", "default": false },
      { "key": "topics.chinese", "type": "boolean", "label": "主题 · 中文阅读", "description": "信源：少数派（sspai.com）、一天世界（blog.yitianshijie.net）", "default": false },
      { "key": "topics.science", "type": "boolean", "label": "主题 · 科学与研究", "description": "信源：NASA（nasa.gov）、Quanta Magazine（quantamagazine.org）", "default": false },
      { "key": "topics.design", "type": "boolean", "label": "主题 · 产品与设计", "description": "信源：Smashing Magazine（smashingmagazine.com）、A List Apart（alistapart.com）", "default": false },
      { "key": "topics.business", "type": "boolean", "label": "主题 · 商业与创业", "description": "信源：Y Combinator（ycombinator.com）、Stripe Blog（stripe.com）", "default": false },
      { "key": "topics.security", "type": "boolean", "label": "主题 · 安全与隐私", "description": "信源：Krebs on Security（krebsonsecurity.com）、Google Project Zero（projectzero.google）", "default": false },
      { "key": "translation.auto-enabled", "type": "boolean", "label": "自动翻译标题与摘要（需要消耗 Token）", "default": true },
      { "key": "translation.target-language", "type": "select", "label": "翻译目标语言", "required": true, "default": "zh-CN", "options": [
        { "value": "zh-CN", "label": "简体中文" },
        { "value": "zh-TW", "label": "繁体中文" },
        { "value": "en", "label": "英语" },
        { "value": "ja", "label": "日语" },
        { "value": "ko", "label": "韩语" }
      ] },
      { "key": "digest.auto-enabled", "type": "boolean", "label": "每日自动生成分类日报（需要消耗 Token）", "default": false },
      { "key": "digest.generation-time", "type": "select", "label": "日报生成时间（设备时区）", "required": true, "default": "08:00", "options": [
        { "value": "00:00", "label": "00:00" },
        { "value": "01:00", "label": "01:00" },
        { "value": "02:00", "label": "02:00" },
        { "value": "03:00", "label": "03:00" },
        { "value": "04:00", "label": "04:00" },
        { "value": "05:00", "label": "05:00" },
        { "value": "06:00", "label": "06:00" },
        { "value": "07:00", "label": "07:00" },
        { "value": "08:00", "label": "08:00" },
        { "value": "09:00", "label": "09:00" },
        { "value": "10:00", "label": "10:00" },
        { "value": "11:00", "label": "11:00" },
        { "value": "12:00", "label": "12:00" },
        { "value": "13:00", "label": "13:00" },
        { "value": "14:00", "label": "14:00" },
        { "value": "15:00", "label": "15:00" },
        { "value": "16:00", "label": "16:00" },
        { "value": "17:00", "label": "17:00" },
        { "value": "18:00", "label": "18:00" },
        { "value": "19:00", "label": "19:00" },
        { "value": "20:00", "label": "20:00" },
        { "value": "21:00", "label": "21:00" },
        { "value": "22:00", "label": "22:00" },
        { "value": "23:00", "label": "23:00" }
      ] },
      { "key": "digest.window-hours", "type": "number", "label": "日报时间范围（小时）", "default": 24, "min": 1, "max": 168, "step": 1 },
      { "key": "digest.max-articles", "type": "number", "label": "每个分类的文章上限", "default": 20, "min": 1, "max": 40, "step": 1 }
    ]
  },
  "permissions": [
    "ai:generate",
    "network",
    "network:public",
    "storage",
    "notes:read",
    "notes:write",
    "schedules",
    "metadata:read",
    "ui:commands",
    "ui:notices"
  ]
}
