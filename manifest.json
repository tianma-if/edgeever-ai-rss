{
  "type": "plugin",
  "id": "org.edgeever.plugins.ai-rss",
  "name": "EdgeEver AI RSS",
  "version": "0.2.0",
  "apiVersion": "1",
  "description": "AI-first RSS and Atom reading, translation, summarization, filtering, recommendations, and note capture.",
  "author": "EdgeEver",
  "entry": "./main.js",
  "platforms": ["web", "desktop"],
  "settings": {
    "fields": [
      { "key": "topics.ai", "type": "boolean", "label": "主题 · AI 前沿", "description": "模型、研究、工具与 AI 产品。", "default": true },
      { "key": "topics.engineering", "type": "boolean", "label": "主题 · 开发与开源", "description": "工程实践、平台更新与开源生态。", "default": false },
      { "key": "topics.chinese", "type": "boolean", "label": "主题 · 中文阅读", "description": "中文科技、产品与独立写作。", "default": false },
      { "key": "topics.science", "type": "boolean", "label": "主题 · 科学与研究", "description": "自然科学、数学与航天。", "default": false },
      { "key": "topics.design", "type": "boolean", "label": "主题 · 产品与设计", "description": "产品方法、Web 与交互设计。", "default": false },
      { "key": "topics.business", "type": "boolean", "label": "主题 · 商业与创业", "description": "创业、公司与科技商业。", "default": false },
      { "key": "topics.security", "type": "boolean", "label": "主题 · 安全与隐私", "description": "漏洞、安全工程与隐私。", "default": false },
      { "key": "reader.auto-refresh", "type": "boolean", "label": "打开时自动刷新", "description": "每次打开阅读面板时获取所选主题的最新公开订阅。", "default": true },
      { "key": "digest.auto-enabled", "type": "boolean", "label": "每日自动生成分类日报", "description": "桌面端按设定时间自动生成；每个有内容的主题调用一次工作区默认 AI。启用前请先在阅读面板选择目标笔记本。默认关闭。", "default": false },
      { "key": "digest.generation-time", "type": "select", "label": "日报生成时间", "description": "使用当前设备时区；保存后立即更新桌面端计划。", "required": true, "default": "08:00", "options": [
        { "value": "00:00", "label": "00:00" },
        { "value": "01:00", "label": "01:00" },
        { "value": "02:00", "label": "02:00" },
        { "value": "03:00", "label": "03:00" },
        { "value": "04:00", "label": "04:00" },
        { "value": "05:00", "label": "05:00" },
        { "value": "06:00", "label": "06:00" },
        { "value": "07:00", "label": "07:00" },
        { "value": "08:00", "label": "08:00" },
        { "value": "09:00", "label": "09:00" },
        { "value": "10:00", "label": "10:00" },
        { "value": "11:00", "label": "11:00" },
        { "value": "12:00", "label": "12:00" },
        { "value": "13:00", "label": "13:00" },
        { "value": "14:00", "label": "14:00" },
        { "value": "15:00", "label": "15:00" },
        { "value": "16:00", "label": "16:00" },
        { "value": "17:00", "label": "17:00" },
        { "value": "18:00", "label": "18:00" },
        { "value": "19:00", "label": "19:00" },
        { "value": "20:00", "label": "20:00" },
        { "value": "21:00", "label": "21:00" },
        { "value": "22:00", "label": "22:00" },
        { "value": "23:00", "label": "23:00" }
      ] },
      { "key": "digest.window-hours", "type": "number", "label": "日报时间范围（小时）", "description": "每篇分类日报向前汇总的时间范围，可设置为 1 至 168 小时。", "default": 24, "min": 1, "max": 168, "step": 1 },
      { "key": "digest.max-articles", "type": "number", "label": "每个分类的文章上限", "description": "单篇分类日报最多交给 AI 处理的文章数量，可设置为 1 至 40。", "default": 20, "min": 1, "max": 40, "step": 1 }
    ]
  },
  "permissions": [
    "ai:generate",
    "network",
    "network:public",
    "storage",
    "notes:read",
    "notes:write",
    "schedules",
    "metadata:read",
    "ui:commands",
    "ui:notices",
    "ui:panels"
  ]
}
