{
  "type": "plugin",
  "id": "org.edgeever.plugins.ai-rss",
  "name": "EdgeEver AI RSS",
  "version": "0.5.5",
  "apiVersion": "2",
  "settingsUi": "host",
  "description": "AI-generated daily digests from curated RSS and Atom feeds, saved directly to EdgeEver notes.",
  "author": "EdgeEver",
  "entry": "./main.js",
  "platforms": ["web", "desktop"],
  "settings": {
    "fields": [
      { "key": "topics.ai", "type": "boolean", "label": "主题 · AI 前沿", "default": true, "list": { "title": "AI 前沿信源", "actionLabel": "查看信源", "items": [
        { "title": "OpenAI News", "description": "openai.com" },
        { "title": "Google AI", "description": "blog.google" },
        { "title": "Google DeepMind", "description": "deepmind.google" },
        { "title": "Apple Machine Learning Research", "description": "machinelearning.apple.com" },
        { "title": "MIT AI News", "description": "news.mit.edu" },
        { "title": "Hugging Face", "description": "huggingface.co" },
        { "title": "TLDR AI", "description": "tldr.tech" },
        { "title": "Ben's Bites", "description": "bensbites.com" },
        { "title": "Import AI", "description": "importai.substack.com" },
        { "title": "NLP Newsletter", "description": "nlp.elvissaravia.com" },
        { "title": "Interconnects", "description": "interconnects.ai" },
        { "title": "One Useful Thing", "description": "oneusefulthing.org" },
        { "title": "科学空间", "description": "kexue.fm" },
        { "title": "ChinAI Newsletter", "description": "chinai.substack.com" },
        { "title": "Simon Willison's Weblog", "description": "simonwillison.net" },
        { "title": "Gary Marcus", "description": "garymarcus.substack.com" },
        { "title": "Dwarkesh Patel", "description": "dwarkeshpatel.com" },
        { "title": "Latent Space", "description": "latent.space" },
        { "title": "The Rundown AI", "description": "therundown.ai" },
        { "title": "Why Try AI", "description": "whytryai.com" },
        { "title": "Geoffrey Litt", "description": "geoffreylitt.com" },
        { "title": "Tyler Folkman", "description": "tylerfolkman.substack.com" },
        { "title": "乔木博客", "description": "blog.qiaomu.ai" },
        { "title": "Lex Fridman Podcast", "description": "lexfridman.com" },
        { "title": "Lilian Weng", "description": "lilianweng.github.io" },
        { "title": "Google Research", "description": "research.google" },
        { "title": "NVIDIA AI", "description": "blogs.nvidia.com" },
        { "title": "Meta Engineering ML", "description": "engineering.fb.com" },
        { "title": "Microsoft Research", "description": "microsoft.com" },
        { "title": "Together AI", "description": "together.ai" },
        { "title": "The Gradient", "description": "thegradient.pub" },
        { "title": "Sebastian Raschka", "description": "magazine.sebastianraschka.com" },
        { "title": "SemiAnalysis", "description": "semianalysis.com" },
        { "title": "MIT Technology Review AI", "description": "technologyreview.com" },
        { "title": "Ars Technica AI", "description": "arstechnica.com" },
        { "title": "The Verge AI", "description": "theverge.com" },
        { "title": "Alignment Forum", "description": "alignmentforum.org" },
        { "title": "EleutherAI", "description": "blog.eleuther.ai" },
        { "title": "Cursor", "description": "cursor.com" },
        { "title": "arXiv cs.AI", "description": "arxiv.org" },
        { "title": "Hugging Face Papers", "description": "huggingface.co" }
      ] } },
      { "key": "topics.engineering", "type": "boolean", "label": "主题 · 开发与开源", "default": false, "list": { "title": "开发与开源信源", "actionLabel": "查看信源", "items": [
        { "title": "GitHub Changelog", "description": "github.blog" },
        { "title": "Cloudflare Blog", "description": "blog.cloudflare.com" }
      ] } },
      { "key": "topics.chinese", "type": "boolean", "label": "主题 · 中文阅读", "default": false, "list": { "title": "中文阅读信源", "actionLabel": "查看信源", "items": [
        { "title": "少数派", "description": "sspai.com" },
        { "title": "一天世界", "description": "blog.yitianshijie.net" }
      ] } },
      { "key": "topics.science", "type": "boolean", "label": "主题 · 科学与研究", "default": false, "list": { "title": "科学与研究信源", "actionLabel": "查看信源", "items": [
        { "title": "NASA", "description": "nasa.gov" },
        { "title": "Quanta Magazine", "description": "quantamagazine.org" }
      ] } },
      { "key": "topics.design", "type": "boolean", "label": "主题 · 产品与设计", "default": false, "list": { "title": "产品与设计信源", "actionLabel": "查看信源", "items": [
        { "title": "Smashing Magazine", "description": "smashingmagazine.com" },
        { "title": "A List Apart", "description": "alistapart.com" }
      ] } },
      { "key": "topics.business", "type": "boolean", "label": "主题 · 商业与创业", "default": false, "list": { "title": "商业与创业信源", "actionLabel": "查看信源", "items": [
        { "title": "Y Combinator", "description": "ycombinator.com" },
        { "title": "Stripe Blog", "description": "stripe.com" }
      ] } },
      { "key": "topics.security", "type": "boolean", "label": "主题 · 安全与隐私", "default": false, "list": { "title": "安全与隐私信源", "actionLabel": "查看信源", "items": [
        { "title": "Krebs on Security", "description": "krebsonsecurity.com" },
        { "title": "Google Project Zero", "description": "projectzero.google" }
      ] } },
      { "key": "translation.auto-enabled", "type": "boolean", "label": "自动翻译标题与摘要（需要消耗 Token）", "default": true },
      { "key": "translation.target-language", "type": "select", "label": "翻译目标语言", "required": true, "default": "zh-CN", "options": [
        { "value": "zh-CN", "label": "简体中文" },
        { "value": "zh-TW", "label": "繁体中文" },
        { "value": "en", "label": "英语" },
        { "value": "ja", "label": "日语" },
        { "value": "ko", "label": "韩语" }
      ] },
      { "key": "digest.auto-enabled", "type": "boolean", "label": "每日自动生成分类日报（需要消耗 Token）", "default": false },
      { "key": "digest.generation-time", "type": "select", "label": "日报生成时间（设备时区）", "required": true, "default": "08:00", "options": [
        { "value": "00:00", "label": "00:00" },
        { "value": "01:00", "label": "01:00" },
        { "value": "02:00", "label": "02:00" },
        { "value": "03:00", "label": "03:00" },
        { "value": "04:00", "label": "04:00" },
        { "value": "05:00", "label": "05:00" },
        { "value": "06:00", "label": "06:00" },
        { "value": "07:00", "label": "07:00" },
        { "value": "08:00", "label": "08:00" },
        { "value": "09:00", "label": "09:00" },
        { "value": "10:00", "label": "10:00" },
        { "value": "11:00", "label": "11:00" },
        { "value": "12:00", "label": "12:00" },
        { "value": "13:00", "label": "13:00" },
        { "value": "14:00", "label": "14:00" },
        { "value": "15:00", "label": "15:00" },
        { "value": "16:00", "label": "16:00" },
        { "value": "17:00", "label": "17:00" },
        { "value": "18:00", "label": "18:00" },
        { "value": "19:00", "label": "19:00" },
        { "value": "20:00", "label": "20:00" },
        { "value": "21:00", "label": "21:00" },
        { "value": "22:00", "label": "22:00" },
        { "value": "23:00", "label": "23:00" }
      ] },
      { "key": "digest.window-hours", "type": "number", "label": "日报时间范围（小时）", "default": 24, "min": 1, "max": 168, "step": 1 },
      { "key": "digest.max-articles", "type": "number", "label": "每个分类的文章上限", "default": 20, "min": 1, "max": 40, "step": 1 }
    ]
  },
  "permissions": [
    "ai:generate",
    "network",
    "network:public",
    "storage",
    "notes:read",
    "notes:write",
    "schedules",
    "metadata:read",
    "ui:commands",
    "ui:notices"
  ]
}
